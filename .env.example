# 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
# cp .env.example .env

ANTHROPIC_API_KEY=sk-ant-...

# 브라우저에서 이 API를 호출할 수 있는 프론트 주소. 쉼표로 구분합니다.
# 스키마 + 호스트 + 포트만 씁니다. 예: https://your-frontend.example
# 비우면 아래 로컬 개발 주소만 허용됩니다.
#   http://localhost:3000
#   http://127.0.0.1:3000
#   http://localhost:5173
#   http://127.0.0.1:5173
# 호스트에 프론트를 붙이면 그 주소를 여기 넣으세요. * 는 사용할 수 없습니다.
# ALLOWED_ORIGINS=https://your-frontend.example,http://localhost:5173
